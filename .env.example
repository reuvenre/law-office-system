# --- Database: Neon Postgres (EU / Frankfurt) ---
# Pooled connection string from the Neon dashboard.
DATABASE_URL=

# --- Auth.js v5 ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID, Web app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails permitted to sign in (the two lawyers' Google emails)
ALLOWED_EMAILS=

# --- Storage: Vercel Blob ---
BLOB_READ_WRITE_TOKEN=

# --- Messaging providers (Phase 7 — optional until reminders go live) ---
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM=office@example.com

# --- Cron protection (reminders + retainers) ---
CRON_SECRET=

# --- Payment provider webhook (integration kit) ---
# Guards the LEGACY generic endpoint /api/webhooks/payment, for manual or
# proxied integrations. Real providers instead POST to the self-verifying
# per-provider endpoints (/api/webhooks/payment/grow | /cardcom), which need no
# secret because they confirm every callback against the provider's own API.
PAYMENT_WEBHOOK_SECRET=

# --- Online payments (client portal) — optional; pay buttons hide without it ---
# Pin a provider ("grow" | "cardcom"); otherwise the first configured one wins.
PAYMENT_PROVIDER=
# Grow / Meshulam
GROW_USER_ID=
GROW_PAGE_CODE=
GROW_API_KEY=
# Defaults to the sandbox host — set the production base for live charges.
GROW_API_BASE=
# Cardcom
CARDCOM_TERMINAL=
CARDCOM_API_NAME=
# Optional override; defaults to {APP_URL}/api/webhooks/payment/cardcom
CARDCOM_WEBHOOK_URL=
# In the Meshulam/Grow page settings, set the notification URL to:
#   {APP_URL}/api/webhooks/payment/grow

# --- Public base URL ---
# The origin the app is served from. Used to build client-portal magic links
# ({APP_URL}/portal/access/<token>), the payment success redirect, and the
# Cardcom webhook URL — so it must be the address clients actually reach.
# Production: https://law.office.win-solutions.co.il
# Local:      http://localhost:3000
# Falls back to NEXTAUTH_URL, then http://localhost:3000
APP_URL=

# --- Make / Drive sync (Phase 7b) ---
MAKE_WEBHOOK_URL=
# Shared bearer secret Make sends to /api/integrations/drive-callback
MAKE_CALLBACK_SECRET=

# --- AI assist (win-solutions) — optional; the AI features are inert without it ---
ANTHROPIC_API_KEY=
# Override the model used for drafting/summaries (default: claude-opus-5)
ANTHROPIC_MODEL=
